{
  "name": "retailpulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5701 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'e2e/**/*.ts' 'public/**/*.json' '.github/workflows/*.yml' '*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'e2e/**/*.ts' 'public/**/*.json' '.github/workflows/*.yml' '*.{ts,js,json}'",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview --host 127.0.0.1 --port 5701 --strictPort",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
